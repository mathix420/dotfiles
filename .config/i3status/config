general {
    output_format = "i3bar"
    colors = true
    color_good = "#98c379"
    color_degraded = "#e5c07b"
    color_bad = "#e06c75"
    interval = 2
}

order += "cpu_usage"
order += "memory"
order += "disk /"
order += "ethernet enp88s0"
order += "wireless wlan0"
order += "volume master"
order += "tztime local"

cpu_usage {
    format = ""
    max_threshold = 90
    format_above_threshold = " 󰍛  %usage "
    degraded_threshold = 75
    format_above_degraded_threshold = " 󰍛  %usage "
}

memory {
    format = ""
    threshold_degraded = "25%"
    threshold_critical = "10%"
    format_degraded = " 󰘚  %percentage_used "
}

disk "/" {
    format = ""
    format_below_threshold = " 󰋊  %avail "
    low_threshold = 25
    threshold_type = "percentage_avail"
}

ethernet enp88s0 {
    format_up = " 󰈀  %ip "
    format_down = ""
}

wireless wlan0 {
    format_up = " 󰤨  %essid %quality "
    format_down = ""
}

volume master {
    format = " 󰕾  %volume "
    format_muted = " 󰖁  muted "
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

tztime local {
    format = "   %a %d %b   %H:%M"
    timezone = "Europe/Paris"
}
